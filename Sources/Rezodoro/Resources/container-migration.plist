<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- On the first sandboxed launch, macOS moves the session/event logs
         written by earlier, unsandboxed builds into the app's container. -->
    <key>Move</key>
    <array>
        <string>${ApplicationSupport}/Rezodoro</string>
    </array>
</dict>
</plist>
